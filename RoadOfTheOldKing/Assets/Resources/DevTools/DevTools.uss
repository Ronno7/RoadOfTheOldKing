#dev-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(232, 233, 222); font-size: 20px; -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKPixel.asset"); }
#effects { display: none; max-width: 70%; white-space: normal; padding: 6px 14px; position: absolute; right: 16px; top: 12px; color: rgb(235, 192, 100); }
#overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8, 12, 13, 0.16); }
#panel { position: absolute; right: 16px; top: 16px; bottom: 16px; width: 510px; max-width: 95%; padding: 18px; }
.row { flex-direction: row; align-items: center; }
.row > Button { flex-grow: 1; flex-basis: 0; }
.title { font-size: 24px; flex-grow: 1; color: rgb(247, 240, 219); }
#close { flex-grow: 0; flex-basis: auto; }
#summary { font-size: 18px; white-space: normal; margin: 8px 0; color: rgb(162, 179, 178); }
.toolbar { margin-bottom: 8px; }
#pause { flex-grow: 1; }
#reset { flex-grow: 0; flex-basis: auto; }
#tabs { margin-bottom: 8px; }
.tab.selected { color: rgb(245, 220, 160); }
#scroll { flex-grow: 1; margin-bottom: 8px; }
#scroll .unity-scroll-view__content-container { padding-right: 8px; padding-bottom: 8px; }
.section-title { margin: 12px 0 5px 0; color: rgb(226, 199, 141); }
.hint { font-size: 18px; color: rgb(162, 179, 178); white-space: normal; margin: 4px 0 8px 0; }
Button { min-height: 36px; padding: 6px 10px; margin: 3px 4px 3px 0; border-width: 0; color: rgb(235, 237, 227); font-size: 20px; }
Button.danger { color: rgb(241, 178, 161); }
Button:disabled { opacity: 0.4; }
Toggle { margin: 6px 0; min-height: 24px; }
.unity-toggle__label { min-width: 155px; }
.unity-toggle__input { flex-grow: 0; min-width: 24px; min-height: 20px; }
.unity-toggle__checkmark { width: 18px; height: 18px; background-color: rgb(16, 23, 25); border-width: 1px; border-color: rgb(110, 130, 128); }
.unity-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark { background-color: rgb(220, 183, 105); -unity-background-image-tint-color: rgb(25, 31, 32); }
.unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark { border-color: rgb(255, 225, 153); }
Foldout { margin-top: 12px; }
.unity-foldout__toggle > .unity-toggle__input { flex-grow: 1; }
.unity-foldout__text { flex-grow: 1; }
#scroll .unity-scroller--vertical { width: 10px; }
#scroll .unity-scroller__low-button, #scroll .unity-scroller__high-button { display: none; }
.unity-base-slider__tracker { background-color: rgb(18, 24, 25); }
.unity-base-slider__dragger { background-color: rgb(85, 108, 108); border-width: 0; }
Slider { margin: 8px 0; min-height: 28px; }
.unity-base-field__label { min-width: 125px; color: rgb(213, 222, 214); }
.unity-base-field__input { background-color: rgb(16, 23, 25); color: rgb(242, 232, 203); }
.unity-base-text-field__input { padding: 5px; }
.row > FloatField { flex-grow: 1; flex-basis: 0; min-width: 0; }
.row > FloatField > .unity-base-field__label { min-width: 15px; }
.amount { width: 190px; }
.amount > .unity-base-field__label { min-width: 75px; }
.resource-amount { flex-grow: 1; min-width: 0; }
.resource-amount > .unity-base-field__label { min-width: 160px; }
.row > .give { flex-grow: 0; flex-basis: auto; width: 76px; }
#result { min-height: 44px; padding: 8px; color: rgb(188, 221, 196); white-space: normal; font-size: 18px; }
#result.error { color: rgb(242, 183, 147); }
#panel, #effects, Button { background-image: url("project://database/Assets/Art/Sprites/UI/DevTools/Panel.png"); -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2; background-color: rgba(0, 0, 0, 0); }
Button:hover, Button:focus, Button:active, .tab.selected { background-image: url("project://database/Assets/Art/Sprites/UI/DevTools/PanelSelected.png"); }
