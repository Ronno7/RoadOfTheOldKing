<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DevTools.uss" />
    <ui:VisualElement name="dev-root" picking-mode="Ignore">
        <ui:Label name="effects" picking-mode="Ignore" />
        <ui:VisualElement name="overlay">
            <ui:VisualElement name="panel">
                <ui:VisualElement class="row header">
                    <ui:Label text="DEV TOOLS" class="title" />
                    <ui:Button name="close" text="Close [F4]" />
                </ui:VisualElement>
                <ui:Label name="summary" />
                <ui:VisualElement class="row toolbar">
                    <ui:Toggle name="pause" label="Pause while open" />
                    <ui:Button name="reset" text="Reset overrides" />
                </ui:VisualElement>
                <ui:VisualElement name="tabs" class="row" />
                <ui:ScrollView name="scroll" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="player-page" />
                    <ui:VisualElement name="items-page" />
                    <ui:VisualElement name="travel-page" />
                </ui:ScrollView>
                <ui:Label name="result" text="Ready" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
