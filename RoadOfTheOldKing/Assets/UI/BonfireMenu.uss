/* Bonfire menu: the shared menu layout and kit rows inside a regional skin (user, 17 Oct). The world stays visible
   (a bonfire does not pause): a light veil, the panel on the right while the camera frames the resting hero on the
   left third (BonfireMenu). BonfireMenu puts skin-<name> on the panel from Bonfire.MenuSkin; a new region adds its
   skin class and kit sprites here, with no other changes. */
#bonfire-overlay { align-items: flex-end; padding-right: 8%; background-color: rgba(15, 19, 18, 0.2); }
#bonfire-panel { width: 384px; }
/* Short of the next upgrade's shards (or at a fire that cannot sell them): the count and requirement turn red. */
#shards.lacking, #status.warning { color: var(--kit-red); }

/* Green Lowlands and the Tutorial: squared oak beams lashed with rope, with a flame crest on the top beam. */
.skin-hearth {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/HearthPanel.png");
    -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12; -unity-slice-type: tiled;
    padding: 36px 40px 28px 40px;
}
.skin-hearth > .menu-crest {
    display: flex; width: 42px; height: 42px; margin-left: -20px; top: -20px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/HearthCrest.png");
}
