/* Bonfire menu: the shared menu layout and kit rows inside a regional skin (user, 17 Oct). The world stays visible
   (a bonfire does not pause): a light veil, the panel on the right while the camera frames the resting hero on the
   left third (BonfireMenu). BonfireMenu puts skin-<name> on the panel from Bonfire.MenuSkin; a new region adds its
   skin class and kit sprites here, with no other changes. */
#bonfire-overlay { align-items: flex-end; padding-right: 8%; background-color: rgba(15, 19, 18, 0.2); }
#bonfire-panel { width: 384px; }
/* Upgrade descriptions wrap to three lines (20 px each); reserving them keeps the panel from resizing as the selection
   moves between rows with and without one. */
#bonfire-panel .menu-description { min-height: 60px; }
/* Short of the next upgrade's shards (or at a fire that cannot sell them): the count and requirement turn red. */
#shards.lacking, #status.warning { color: var(--kit-red); }

/* Green Lowlands and the Tutorial: squared oak beams lashed with rope, with a flame crest on the top beam. */
.skin-hearth {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/HearthPanel.png");
    -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12; -unity-slice-type: tiled;
    padding: 36px 40px 28px 40px;
}
.skin-hearth > .menu-crest {
    display: flex; width: 42px; height: 42px; margin-left: -20px; top: -20px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/HearthCrest.png");
}

/* An upgrade fire (user, 18 Nov: "a unique border for the upgrade bonfire UI"): the same frame in bronze bands with a
   sun-gold inner line and gold-gem corner plates, and a gold-rimmed crest with the gold flame. Any region's skin. */
#bonfire-panel.upgrade-fire {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/ForgePanel.png");
    -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12; -unity-slice-type: tiled;
}
#bonfire-panel.upgrade-fire > .menu-crest {
    display: flex; width: 42px; height: 42px; margin-left: -20px; top: -20px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/ForgeCrest.png");
}
/* Its Upgrades row: gold even when short of shards, in a gold-edged bar when selected. Only when an upgrade can be
   bought (.available) does it pulse to pale flame gold and very slightly larger (BonfireMenu toggles .glow; user,
   19 Nov: "save the strobing ... for when an upgrade is actually available ... subtly pulse in scale"). */
#bonfire-panel .kit-row.upgrade-row { color: var(--kit-gold); }
#bonfire-panel .kit-row.upgrade-row.available { transition-property: color, scale; transition-duration: 0.7s; }
#bonfire-panel .kit-row.upgrade-row.available.glow { color: rgb(255, 237, 166); scale: 1.06 1.06; }
#bonfire-panel .kit-row.upgrade-row.selected {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/SelectedGold.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
}
