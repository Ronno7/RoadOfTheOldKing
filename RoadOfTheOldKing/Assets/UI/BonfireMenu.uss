/* The world stays visible at a bonfire (it is not paused): a light veil and the Hearth panel on the right,
   while the camera zooms in and frames the resting hero on the left third (BonfireMenu). Hearth frame,
   326 px wide (the 201 px half-size panel grown about 35%, then 20%; user, 3 Oct). Frame and ornaments: OrnateMenu.uss. */
#bonfire-overlay { align-items: flex-end; padding-right: 8%; background-color: rgba(15, 19, 18, 0.2); }
#bonfire-panel { width: 326px; }
#bonfire-panel .menu-heading { font-size: 20px; }
#bonfire-panel .menu-text, #bonfire-panel .menu-meta, #bonfire-panel .menu-description { font-size: 10px; }
#bonfire-panel .menu-meta { margin-bottom: 8px; }
#bonfire-panel .menu-description { min-height: 12px; margin-top: 4px; }
#bonfire-panel .menu-hint { margin-top: 6px; }
#bonfire-panel .menu-button { height: 28px; margin-bottom: 5px; }
