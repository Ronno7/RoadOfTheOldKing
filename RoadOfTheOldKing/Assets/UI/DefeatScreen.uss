/* Defeat retains its red veil and title typography, with the plain shared frame. */
#defeat-overlay { background-color: rgba(38, 8, 6, 0.55); }
#defeat-panel { width: 340px; padding-top: 22px; }
#defeat-panel #heading {
    color: rgb(214, 106, 92); font-size: 48px; margin-top: 2px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKTitle32.asset");
}
#defeat-panel .menu-button { height: 36px; font-size: 20px; }
