/* Inscription reader: the shared panel, wide enough for carved text read left-aligned. */
#inscription-overlay { display: none; background-color: rgba(15, 19, 18, 0.3); }
#inscription-panel { width: 440px; }
#inscription-panel .menu-text { -unity-text-align: upper-left; margin-bottom: 16px; }
#inscription-panel #close { margin: 0 48px; }
