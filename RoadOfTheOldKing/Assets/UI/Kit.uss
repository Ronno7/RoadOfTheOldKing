/* Ardan UI kit (user, 17 Oct): one style for every panel, menu, HUD chip and prompt.
   One UI pixel = 2 reference px on the 960x540 reference canvas (4 screen px at 1080p), so every size here is a
   multiple of 2. Kit sprites (Assets/Art/Sprites/UI/Kit, drawn by Tools/Art/UI/ui_kit.py) import at 50 PPU, so one
   sprite pixel is one UI pixel; 9-slice values below are in sprite pixels. Text is RotOK Pixel at 20 px (body: one
   font pixel per UI pixel) or 40 px (display). Colors: zone palette plus the sun-gold accent.
   Screens import this sheet first and build on the shared pieces. */
:root {
    --kit-ink: rgb(23, 28, 27);          /* ink */
    --kit-fill: rgb(66, 72, 63);         /* rockshadow: panel body */
    --kit-inset: rgb(50, 63, 62);        /* slatedark: descriptions, slots, selected rows */
    --kit-trim: rgb(163, 130, 94);       /* soilmid: bronze trim */
    --kit-trim-dark: rgb(130, 102, 76);  /* soil */
    --kit-text: rgb(210, 204, 171);      /* stonelight */
    --kit-muted: rgb(177, 180, 150);     /* stone */
    --kit-disabled: rgb(140, 146, 118);  /* stoneshade */
    --kit-gold: rgb(231, 184, 92);       /* sun gold: selection, headings, key names */
    --kit-red: rgb(202, 110, 87);        /* danger */
}

.kit-type {
    color: var(--kit-text); font-size: 20px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKPixel.asset"); -unity-font-style: normal;
}

/* Main frame: ink outline, bronze trim lit from the upper left, corner rivets. */
.kit-panel {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Panel.png");
    -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6;
    padding: 24px 28px 20px 28px;
}

/* Recessed areas: descriptions, item slots. */
.kit-inset {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Inset.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
}

/* Small framed labels: receipts, prompts, the axe-away chip; the hint variant adds a bronze ledge. */
.kit-chip {
    flex-direction: row; align-items: center; padding: 4px 12px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Chip.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
}
.kit-chip-edge {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/ChipEdge.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
}

/* Heading divider: a bronze line over ink, with the sun-gold gem at its centre. */
.kit-divider {
    height: 4px; margin: 8px 0 12px 0; overflow: visible; flex-shrink: 0;
    background-color: var(--kit-ink); border-top-width: 2px; border-top-color: var(--kit-trim-dark);
}
.kit-gem {
    position: absolute; width: 10px; height: 10px; left: 50%; margin-left: -4px; top: -4px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/DividerGem.png");
}

/* A list row: plain text; the selected row sits in the bronze bar with gold text and the cursor beside it. Only the
   selection is highlighted, never :hover: the pointer selects a row it enters (MenuList), and a mouse left resting on
   one row while keys or a pad move the selection would otherwise light two rows. */
.kit-row {
    height: 28px; margin: 0 0 4px 0; padding: 0 8px; overflow: visible;
    background-color: rgba(0, 0, 0, 0); background-image: none; border-width: 0; border-radius: 0;
    color: var(--kit-text); font-size: 20px; -unity-font-style: normal; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKPixel.asset");
}
.kit-row.selected {
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Selected.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
    color: var(--kit-gold);
}
.kit-row:disabled { color: var(--kit-disabled); opacity: 1; }
/* Locked: still selectable for browsing, but not yet within reach (an upgrade without the shards). */
.kit-row.locked { color: var(--kit-disabled); }
.kit-row.locked.selected { color: var(--kit-muted); }
.kit-cursor {
    display: none; position: absolute; width: 10px; height: 14px; left: -16px; top: 7px;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Cursor.png");
}
.kit-row.selected > .kit-cursor { display: flex; }

/* Control glyphs (ControlGlyphs; user, 23 Nov): controls drawn as icons on a 12 UI px line, never "[F]" in brackets.
   Every control is a drawn sprite, each its own width, its name in the icon capitals (ui_kit.py); a key without a
   sprite falls back to the keycap holding its name in gold. */
.glyph-line { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; }
.glyph-group { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 6px 0 0; }
.glyph-word { margin: 0 6px 0 0; padding: 0; white-space: nowrap; }
.glyph-group .glyph-word { margin-right: 4px; }
.glyph { height: 24px; flex-shrink: 0; margin: 0 2px 0 0; }
.glyph-key {
    min-width: 20px; padding: 2px 6px 6px 6px; justify-content: center; align-items: center;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyCap.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 4;
}
.glyph-key Label { color: var(--kit-gold); margin: 0; padding: 0; -unity-text-align: middle-center; white-space: nowrap; }
.glyph-sprite { width: 24px; }
.glyph-a { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphA.png"); }
.glyph-b { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphB.png"); }
.glyph-x { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphX.png"); }
.glyph-y { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphY.png"); }
.glyph-cross { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphCross.png"); }
.glyph-circle { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphCircle.png"); }
.glyph-square { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphSquare.png"); }
.glyph-triangle { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphTriangle.png"); }
.glyph-start { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphStart.png"); }
.glyph-view { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphView.png"); }
.glyph-create { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphCreate.png"); }
.glyph-ls { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphLS.png"); }
.glyph-rs { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphRS.png"); }
.glyph-dpad { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphDpad.png"); }
.glyph-lb, .glyph-rb, .glyph-l1, .glyph-r1 { width: 30px; }
.glyph-lt, .glyph-rt, .glyph-l2, .glyph-r2 { width: 26px; }
.glyph-lb { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphLB.png"); }
.glyph-rb { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphRB.png"); }
.glyph-l1 { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphL1.png"); }
.glyph-r1 { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphR1.png"); }
.glyph-lt { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphLT.png"); }
.glyph-rt { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphRT.png"); }
.glyph-l2 { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphL2.png"); }
.glyph-r2 { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphR2.png"); }
.glyph-key-f, .glyph-key-e, .glyph-key-r { width: 22px; }
.glyph-key-esc, .glyph-key-tab, .glyph-key-alt { width: 34px; }
.glyph-key-wasd { width: 46px; }
.glyph-key-shift, .glyph-key-space { width: 50px; }
.glyph-key-enter { width: 52px; }
.glyph-key-f { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyF.png"); }
.glyph-key-e { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyE.png"); }
.glyph-key-r { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyR.png"); }
.glyph-key-esc { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyEsc.png"); }
.glyph-key-tab { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyTab.png"); }
.glyph-key-alt { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyAlt.png"); }
.glyph-key-wasd { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyWASD.png"); }
.glyph-key-shift { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyShift.png"); }
.glyph-key-space { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeySpace.png"); }
.glyph-key-enter { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/KeyEnter.png"); }
.glyph-mouse, .glyph-mouse-left, .glyph-mouse-right, .glyph-mouse-wheel { width: 18px; }
.glyph-mouse { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphMouse.png"); }
.glyph-mouse-left { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphMouseLeft.png"); }
.glyph-mouse-right { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphMouseRight.png"); }
.glyph-mouse-wheel { background-image: url("project://database/Assets/Art/Sprites/UI/Kit/GlyphMouseWheel.png"); }
.next-arrow { width: 14px; height: 10px; background-image: url("project://database/Assets/Art/Sprites/UI/Kit/NextArrow.png"); }
