/* Shared layout for every modal menu (pause, settings, bonfire, defeat, title, inscription), built on the Ardan UI
   kit (Kit.uss): heading, divider, status, list, description, hint line. Body text 20 px; sizes are multiples of the
   2 px UI pixel. Rows come from MenuList with the kit-row class. */
@import url("Kit.uss");

.menu-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    color: var(--kit-text); font-size: 20px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKPixel.asset");
}
/* A type selector, so the menu-* classes below can set their own margins (a .menu-overlay Label rule outranks them). */
Label { margin: 0; padding: 0; -unity-font-style: normal; }
.menu-panel {
    width: 336px; max-width: 92%;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Panel.png");
    -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6;
    padding: 24px 28px 20px 28px; overflow: visible;
}
/* Headings: body size, uppercase, sun gold (display size is for banners and the defeat heading). */
.menu-heading { font-size: 20px; color: var(--kit-gold); -unity-text-align: middle-center; white-space: normal; }
.menu-divider {
    height: 4px; margin: 8px 0 12px 0; overflow: visible; flex-shrink: 0;
    background-color: var(--kit-ink); border-top-width: 2px; border-top-color: var(--kit-trim-dark);
}
.menu-text { font-size: 20px; white-space: normal; -unity-text-align: upper-center; margin: 0 0 4px 0; }
.menu-meta { font-size: 20px; color: var(--kit-gold); -unity-text-align: upper-center; margin: 0 0 12px 0; }
#actions { margin: 0 24px; overflow: visible; }
.menu-description {
    min-height: 20px; margin-top: 4px; white-space: normal; font-size: 20px;
    color: var(--kit-muted); -unity-text-align: upper-center;
}
.menu-hint { margin-top: 12px; font-size: 20px; color: var(--kit-muted); -unity-text-align: middle-center; white-space: normal; }
/* The crest sits on a skinned frame's top edge; plain panels hide it. */
.menu-crest { display: none; position: absolute; left: 50%; }
