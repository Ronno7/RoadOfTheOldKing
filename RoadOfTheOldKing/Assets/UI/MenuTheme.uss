/* Shared layout for every modal menu (pause, settings, bonfire, defeat, title, inscription), built on the Ardan UI
   kit (Kit.uss): heading, divider, status, list, description, hint line. Body text 20 px; sizes are multiples of the
   2 px UI pixel. Rows come from MenuList with the kit-row class. */
@import url("Kit.uss");

.menu-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    color: var(--kit-text); font-size: 20px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RotOKPixel.asset");
}
/* A type selector, so the menu-* classes below can set their own margins (a .menu-overlay Label rule outranks them). */
Label { margin: 0; padding: 0; -unity-font-style: normal; }
.menu-panel {
    width: 336px; max-width: 92%;
    background-image: url("project://database/Assets/Art/Sprites/UI/Kit/Panel.png");
    -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6;
    padding: 24px 28px 20px 28px; overflow: visible;
}
/* Headings: body size, uppercase, sun gold (display size is for banners and the defeat heading). */
.menu-heading { font-size: 20px; color: var(--kit-gold); -unity-text-align: middle-center; white-space: normal; }
.menu-divider {
    height: 4px; margin: 8px 0 12px 0; overflow: visible; flex-shrink: 0;
    background-color: var(--kit-ink); border-top-width: 2px; border-top-color: var(--kit-trim-dark);
}
.menu-text { font-size: 20px; white-space: normal; -unity-text-align: upper-center; margin: 0 0 4px 0; }
.menu-meta { font-size: 20px; color: var(--kit-gold); -unity-text-align: upper-center; margin: 0 0 12px 0; }
#actions { margin: 0 24px; overflow: visible; }
.menu-description {
    min-height: 20px; margin-top: 4px; white-space: normal; font-size: 20px;
    color: var(--kit-muted); -unity-text-align: upper-center;
}
.menu-hint { margin-top: 12px; font-size: 20px; color: var(--kit-muted); -unity-text-align: middle-center; white-space: normal; }
/* The crest sits on a skinned frame's top edge; plain panels hide it. */
.menu-crest { display: none; position: absolute; left: 50%; }

/* Option pages (settings, the hood picker; OptionList): a wider panel, small gold group headings, rows with the label on
   the left and the control on the right. A bar is 200 px of evenly divided segments, so 10 and 25 steps stay whole
   pixels. Selected rows reuse the kit row's bronze bar and cursor. */
.menu-panel.options-open { width: 540px; }
.option-list { display: none; margin: 0 8px; overflow: visible; }
.option-header { color: var(--kit-gold); margin: 6px 0 2px 8px; -unity-text-align: middle-left; }
.option-row { flex-direction: row; align-items: center; justify-content: space-between; }
.option-label { -unity-text-align: middle-left; color: var(--kit-text); }
.option-row.selected .option-label, .option-row:hover .option-label { color: var(--kit-gold); }
.option-control { flex-direction: row; align-items: center; }
.option-arrow { width: 16px; -unity-text-align: middle-center; color: var(--kit-muted); }
.option-row.selected .option-arrow { color: var(--kit-gold); }
.option-track { flex-direction: row; align-items: center; width: 200px; height: 20px; }
.option-segment {
    flex-grow: 1; flex-basis: 0; height: 12px; margin-right: 2px;
    background-color: var(--kit-inset); border-width: 0;
}
.option-segment.on { background-color: var(--kit-trim); }
.option-row.selected .option-segment.on { background-color: var(--kit-gold); }
.option-swatch-segment { margin-right: 0; height: 12px; }
.option-swatch-segment.picked {
    height: 20px; border-width: 2px; border-color: var(--kit-ink);
    border-top-color: var(--kit-gold); border-bottom-color: var(--kit-gold);
}
.option-value { width: 52px; -unity-text-align: middle-right; color: var(--kit-muted); }
.option-row.selected .option-value { color: var(--kit-gold); }
.option-choice { width: 140px; -unity-text-align: middle-center; }
.option-swatch {
    width: 16px; height: 16px; margin: 0 2px; border-width: 2px; border-color: var(--kit-ink);
}
.option-swatch.picked { width: 20px; height: 20px; border-color: var(--kit-gold); }
.option-command { -unity-text-align: middle-center; justify-content: center; margin-top: 8px; }
.option-command > Label { -unity-text-align: middle-center; }
