/* Shared look for every modal menu (pause, bonfire, defeat). Placeholder art direction from the UI
   proposal: charcoal panels, warm ivory text, gold accents, square corners. Pixel-art assets (font,
   panel frame, keycaps) replace these blocks later without touching layouts or code. */
.menu-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    color: rgb(242, 229, 193);
}
.menu-panel {
    width: 380px; max-width: 92%; padding: 24px;
    background-color: rgb(37, 40, 35);
    border-width: 3px; border-color: rgb(103, 93, 68);
}
.menu-heading { font-size: 25px; -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 3px; white-space: normal; }
.menu-divider { height: 2px; background-color: rgb(176, 144, 81); margin-top: 14px; margin-bottom: 16px; }
.menu-text { font-size: 14px; white-space: normal; -unity-text-align: upper-center; margin: 0 0 6px 0; }
.menu-meta { font-size: 13px; color: rgb(231, 184, 92); -unity-text-align: upper-center; margin: 0 0 12px 0; }
.menu-button {
    height: 46px; margin: 0 0 10px 0;
    background-color: rgb(54, 58, 48); color: rgb(242, 229, 193);
    border-width: 2px; border-color: rgb(82, 83, 65); border-radius: 0;
    font-size: 19px; -unity-font-style: bold;
}
.menu-button.selected, .menu-button:hover, .menu-button:focus {
    background-color: rgb(74, 73, 52); border-color: rgb(208, 173, 100);
}
.menu-button:active { background-color: rgb(94, 83, 52); }
.menu-button:disabled { opacity: 0.45; }
.menu-description { min-height: 46px; margin-top: 4px; white-space: normal; font-size: 13px; -unity-text-align: upper-center; }
.menu-hint { margin-top: 14px; font-size: 11px; color: rgb(185, 183, 160); -unity-text-align: middle-center; white-space: normal; }
