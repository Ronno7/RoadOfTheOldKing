/* Pause-specific: the game is frozen, so the world dims strongly behind the panel. Shared styles live in MenuTheme.uss. */
#pause-overlay { background-color: rgba(15, 19, 18, 0.65); }

/* Reserve three lines so hover and keyboard selection never resize the panel. */
#pause-panel #description { height: 60px; min-height: 60px; max-height: 60px; flex-shrink: 0; -unity-text-align: middle-center; }
