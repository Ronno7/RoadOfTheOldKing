/* World-space HUD pieces on WorldPanel.asset (32 panel px per unit, so 2 px = 1 art pixel at 16 PPU).
   These are meters drawn in world pixels; text prompts are kit chips on the HUD panel (GameHud.uss). Each
   document's top element is absolute so it keeps its own size (a world document's root otherwise collapses to nothing). */
.world-root { position: absolute; }

/* Heavy-attack charge under the player */
#charge { width: 22px; height: 4px; background-color: rgb(52, 50, 45); border-width: 1px; border-color: rgb(20, 20, 18); }
#charge-fill { height: 100%; width: 0; background-color: rgb(140, 170, 190); }
#charge-fill.ready { background-color: rgb(231, 184, 92); }

/* Enemy health is a PixelBar (drawn in code, health palette): no styles needed beyond .world-root */

/* Awareness "!" (5x11 art pixels) */
#awareness { width: 20px; height: 22px; }
#awareness-mark {
    position: absolute; left: 5px; bottom: 0;
    width: 10px; height: 22px;
    background-image: url("project://database/Assets/Art/Sprites/UI/HUD/AwarenessMark.png");
    -unity-background-scale-mode: scale-to-fit;
}
#awareness-track {
    position: absolute; left: 0; bottom: 8px; width: 20px; height: 6px;
    border-width: 2px; border-color: rgb(30, 34, 31); background-color: rgb(66, 67, 55);
    display: none;
}
#awareness-fill { height: 2px; width: 0; background-color: rgb(220, 220, 195); }
